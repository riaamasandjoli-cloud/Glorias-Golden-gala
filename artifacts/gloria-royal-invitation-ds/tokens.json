        "$value": "#D4AF37",
        "$description": "Metallic gold for primary actions, links, ornaments, and emphasis."
      },
      "primaryForeground": { "$value": "#2B080B" },
      "secondary": { "$value": "#2B080B" },
      "secondaryForeground": { "$value": "#F7F0DF" },
      "muted": { "$value": "#E9DDC8" },
      "mutedForeground": { "$value": "#6E5650" },
      "accent": { "$value": "#F2DC8A" },
      "accentForeground": { "$value": "#2B080B" },
