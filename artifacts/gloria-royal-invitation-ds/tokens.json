  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Clean utility face for labels, controls, and supporting UI."
      },
      "serif": {
        "$value": ["Cinzel", "Georgia", "serif"],
        "$description": "Royal display face for headings, names, dates, and invitation moments."
      },
      "mono": { "$value": ["DM Sans", "sans-serif"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.125rem",
      "$description": "Near-square corners preserve the formal printed-invitation character."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "A restrained four-pixel rhythm expanded into generous editorial whitespace."
    }
  }
